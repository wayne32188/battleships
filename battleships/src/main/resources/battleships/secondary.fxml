<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="battleships.SecondaryController">
    <HBox fx:id="gridBox" spacing="20">
        <GridPane fx:id="playerField"/>
        <GridPane fx:id="enemyField"/>
    </HBox>
    <VBox spacing="10">
        <VBox fx:id="shipsBox" spacing="10"/>
        <Button fx:id="resetButton" text="Schiffe zurücksetzen"/>
        <Button fx:id="openSecondaryButton" text="Neues Fenster öffnen"/>
    </VBox>
</VBox>