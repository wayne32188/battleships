<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<VBox spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="battleships.GameHandlerController" style="-fx-background-color: #e6f0fa;" alignment="TOP_CENTER">
    <Label text="Battleships" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-padding: 20 0 10 0;"/>
    <HBox fx:id="playingGridBox" spacing="40" alignment="CENTER">
        <VBox spacing="10" alignment="CENTER">
            <Label text="Dein Spielfeld" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane fx:id="playerPlayingField" style="-fx-background-color: #d0e6fa; -fx-padding: 10; -fx-border-color: #4682b4; -fx-border-width: 2;"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Label text="Gegnerisches Spielfeld" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane fx:id="enemyPlayingField" style="-fx-background-color: #fbe6e6; -fx-padding: 10; -fx-border-color: #b44646; -fx-border-width: 2;"/>
        </VBox>
    </HBox>
    <Separator/>
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10 0 10 0;">
        <Button text="Angreifen" onAction="#buttonHandler" style="-fx-font-size: 14px;"/>
        <Button text="Zurücksetzen" style="-fx-font-size: 14px;"/>
        <Button text="Beenden" style="-fx-font-size: 14px;"/>
    </HBox>
</VBox>
