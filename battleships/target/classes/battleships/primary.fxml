<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="battleships.ShipController">
    <HBox spacing="20">
        <GridPane fx:id="playerGrid"/>
        <GridPane fx:id="enemyGrid"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Button 1" onAction="#handleButton1"/>
        <Button text="Button 2" onAction="#handleButton2"/>
        <Button text="Button 3" onAction="#handleButton3"/>
    </HBox>
</VBox>
